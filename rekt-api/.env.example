# Fill these in with the NEW Supabase project's values (Project Settings > API).
# Never commit the real .env file — this is a template only.

PORT=3000

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Used to verify incoming Supabase Auth JWTs (Project Settings > API > JWT Settings).
# NOTE: this assumes the project still issues HS256 JWTs signed with a shared secret.
# If the project uses Supabase's newer asymmetric (ES256) signing keys instead, this
# needs to change to JWKS verification — check Project Settings > API > JWT Keys
# before relying on this in production, and update src/shared/security/jwt.ts.
SUPABASE_JWT_SECRET=your-jwt-secret
